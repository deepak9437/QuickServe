    {
      "name": "findAllWithDetails",
      "signature": "public abstract java.util.List<quick.serve.entity.ProviderEntity> quick.serve.repo.ProviderRepository.findAllWithDetails()",
      "query": {
        "query": "    SELECT DISTINCT p\n    FROM ProviderEntity p\n    JOIN FETCH p.user\n    LEFT JOIN FETCH p.pDocs\n"
      }
    },
    {
      "name": "findByStatus",
      "signature": "public abstract java.lang.String quick.serve.repo.ProviderRepository.findByStatus(java.lang.String)",
      "query": {
        "query": "SELECT p FROM ProviderEntity p WHERE p.status = :status"
      }
    },
    {
      "name": "findByUserId",
      "signature": "public abstract java.lang.String quick.serve.repo.ProviderRepository.findByUserId(java.lang.Integer)",
      "query": {
        "query": "select status from provider where user_id =:id"
      }
